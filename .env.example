# DIGIRINGO — environment config
# Copy to ".env" and fill in. Vite only exposes vars prefixed with VITE_ to the app.

# Telnyx integration mode: "mock" (no backend needed) or "live"
VITE_TELNYX_MODE=mock

# Base path the app calls in live mode. This must point at YOUR backend proxy,
# NOT api.telnyx.com (the secret key must never reach the browser).
VITE_API_BASE=/api/telnyx

# Optional defaults used when ordering numbers / sending SMS in live mode
VITE_TELNYX_MESSAGING_PROFILE_ID=
VITE_TELNYX_CONNECTION_ID=

# ---- SERVER-SIDE ONLY (used by server/telnyx-proxy.mjs, never by the app) ----
# Your Telnyx V2 API key. KEEP SECRET. Do not prefix with VITE_.
TELNYX_API_KEY=KEY_xxxxxxxxxxxxxxxxxxxxxxxx
# Port the proxy listens on
TELNYX_PROXY_PORT=8787

# ---- PayPal — payments (the card rail). SERVER-SIDE ONLY. ----
# REST-app credentials from developer.paypal.com → Apps & Credentials. The CLIENT_ID
# is served to the browser (GET /api/paypal/config); the SECRET never reaches it.
# PAYPAL_ENV = "sandbox" for testing, "live" for real money.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
# The webhook id from the PayPal dashboard (Apps → your app → Webhooks). Used to
# verify /api/paypal/webhook signatures. Optional but recommended.
PAYPAL_WEBHOOK_ID=
# Set to 1 ONLY if the merchant account has Reference Transactions enabled — then
# card-plan auto-renew charges the vaulted payer off-session. Leave unset and
# renewals draw from the wallet (wallet top-ups are also by PayPal).
# PAYPAL_VAULT=1

# ---- Stripe — legacy card rail (kept dormant; PayPal replaced it). ----
# Leave blank unless you re-enable Stripe. If both are set, the app UI uses PayPal.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
